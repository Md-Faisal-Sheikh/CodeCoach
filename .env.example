# Copy to .env and edit, or just export these before running. Every value has a
# safe default; the platform runs offline with no configuration at all.

# --- AI (optional) ---
# Set a real key to enable LLM hints/feedback and the LLM leakage judge.
# Leave empty to run the offline heuristic fallback (also the study's control).
ANTHROPIC_API_KEY=
CODECOACH_HINT_MODEL=claude-sonnet-4-6
CODECOACH_JUDGE_MODEL=claude-haiku-4-5-20251001
# Force heuristic mode even if a key is present (e.g. to regenerate the baseline):
CODECOACH_AI_OFFLINE=0

# --- Database ---
CODECOACH_DB_URL=sqlite:///./data/codecoach.db

# --- Sandbox limits ---
CODECOACH_TIME_LIMIT_MS=5000
CODECOACH_MEM_LIMIT_MB=256
CODECOACH_COMPILE_LIMIT_MS=15000
CODECOACH_MAX_OUTPUT_BYTES=262144
CODECOACH_MAX_PROCESSES=64
# The sandbox auto-detects what the host supports and degrades gracefully.
# These force-disable isolation layers (useful on macOS / non-root / CI):
CODECOACH_DISABLE_NET_NS=0
CODECOACH_DISABLE_PRIV_DROP=0
CODECOACH_SANDBOX_USER=nobody

# --- Over-hinting ---
# A hint is flagged as leaking when its combined leakage score >= this.
CODECOACH_LEAKAGE_THRESHOLD=0.5
